{
  "name": "@krantho/config",
  "version": "1.1.1",
  "description": "krantho's typed configuration: defaults, krantho.config.ts and the environment, resolved once into one tree.",
  "license": "MIT",
  "homepage": "https://krantho.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/descoped/krantho.git",
    "directory": "packages/config"
  },
  "bugs": {
    "url": "https://github.com/descoped/krantho/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./public": {
      "types": "./dist/public.d.ts",
      "import": "./dist/public.js",
      "require": "./dist/public.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js",
      "require": "./dist/node/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "reference": "tsx scripts/write-reference.ts",
    "test:bundle": "node test/bundle-boundary.mjs"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
