{
  "name": "@krantho/ui-react",
  "version": "1.0.1",
  "description": "React server components, server utilities and hooks that render published krantho content.",
  "license": "MIT",
  "homepage": "https://krantho.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/descoped/krantho.git",
    "directory": "packages/ui-react"
  },
  "bugs": {
    "url": "https://github.com/descoped/krantho/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@krantho/core": "workspace:*",
    "@krantho/seo-shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  }
}
