{
  "name": "@krantho/api",
  "version": "1.0.2",
  "description": "The krantho REST API: framework-neutral handlers for content, versions, media, SEO, auth, plugins and webhooks, with an OpenAPI 3.1 specification.",
  "license": "MIT",
  "homepage": "https://krantho.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/descoped/krantho.git",
    "directory": "packages/api"
  },
  "bugs": {
    "url": "https://github.com/descoped/krantho/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@krantho/ai": "workspace:*",
    "@krantho/config": "workspace:*",
    "@krantho/core": "workspace:*",
    "@krantho/persistence": "workspace:*",
    "@krantho/schema": "workspace:*",
    "@krantho/seo-shared": "workspace:*",
    "sharp": "^0.35.5"
  },
  "peerDependencies": {
    "@krantho/seo": "workspace:*",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@krantho/seo": {
      "optional": true
    }
  },
  "devDependencies": {
    "@krantho/persistence-sqlite": "workspace:*",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  }
}
