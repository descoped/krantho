{
  "name": "@krantho/core",
  "version": "1.1.0",
  "description": "The krantho content engine: load and render markdown content, change events, cache tags and CDN headers. No UI framework dependencies.",
  "license": "MIT",
  "homepage": "https://krantho.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/descoped/krantho.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/descoped/krantho/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cache-tags": {
      "types": "./dist/cache-tags.d.ts",
      "import": "./dist/cache-tags.js"
    },
    "./content": {
      "types": "./dist/content-resolver.d.ts",
      "import": "./dist/content-resolver.js"
    },
    "./marks": {
      "types": "./dist/marks.d.ts",
      "import": "./dist/marks.js"
    },
    "./sections": {
      "types": "./dist/sections.d.ts",
      "import": "./dist/sections.js"
    },
    "./seo": {
      "types": "./dist/loaders/seo-loader.d.ts",
      "import": "./dist/loaders/seo-loader.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "marked": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
