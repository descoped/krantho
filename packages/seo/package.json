{
  "name": "@krantho/seo",
  "version": "1.0.2",
  "description": "Schema.org structured data for krantho: archetypes composed into one JSON-LD graph, checked against the vocabulary and search engine rules.",
  "license": "MIT",
  "homepage": "https://krantho.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/descoped/krantho.git",
    "directory": "packages/seo"
  },
  "bugs": {
    "url": "https://github.com/descoped/krantho/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "vocabulary": "node scripts/generate-vocabulary.mjs"
  },
  "dependencies": {
    "@krantho/core": "workspace:*",
    "@krantho/seo-shared": "workspace:*"
  },
  "devDependencies": {
    "@adobe/structured-data-validator": "^1.7.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  }
}
