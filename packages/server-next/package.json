  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "typescript": "^6.0.3",
    "zod": "^4.4.3",
    "@krantho/schema": "workspace:*",
    "next": "~16.4.5",
    "react": "^19.2.9",
    "react-dom": "^19.2.9"
  }
