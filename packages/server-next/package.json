{
  "name": "@krantho/server-next",
  "version": "1.1.0",
  "description": "The krantho adapter for the Next.js App Router: API and Studio route handlers, the content loader and page caching.",
  "license": "MIT",
  "homepage": "https://krantho.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/descoped/krantho.git",
    "directory": "packages/server-next"
  },
  "bugs": {
    "url": "https://github.com/descoped/krantho/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cache-handler": {
      "types": "./dist/cache-handler.d.ts",
      "import": "./dist/cache-handler.js",
      "default": "./dist/cache-handler.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@krantho/config": "workspace:*",
    "@krantho/core": "workspace:*",
    "@krantho/server": "workspace:*"
  },
  "peerDependencies": {
    "next": ">=16.3.8"
  },
  "devDependencies": {
    "@krantho/schema": "workspace:*",
    "@types/node": "^26.6.6",
    "next": "~16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  }
}
