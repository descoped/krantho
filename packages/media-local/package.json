{
  "name": "@krantho/media-local",
  "version": "1.0.0",
  "description": "The krantho media file store on local disk, for development and single servers with a persistent volume.",
  "license": "MIT",
  "homepage": "https://krantho.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/descoped/krantho.git",
    "directory": "packages/media-local"
  },
  "bugs": {
    "url": "https://github.com/descoped/krantho/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@krantho/config": "workspace:*",
    "@krantho/persistence": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "typescript": "^6.0.3"
  }
}
