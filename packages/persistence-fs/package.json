{
  "name": "@krantho/persistence-fs",
  "version": "1.0.1",
  "description": "A krantho persistence adapter that reads and writes markdown files directly, for prototypes.",
  "license": "MIT",
  "homepage": "https://krantho.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/descoped/krantho.git",
    "directory": "packages/persistence-fs"
  },
  "bugs": {
    "url": "https://github.com/descoped/krantho/issues"
  },
  "type": "module",
  "exports": {
    ".": {
