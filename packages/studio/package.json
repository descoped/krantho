{
  "name": "@krantho/studio",
  "version": "1.0.1",
  "description": "Studio, the krantho dashboard for editors: a prebuilt React single-page app that every krantho server serves at /studio.",
  "license": "MIT",
  "homepage": "https://krantho.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/descoped/krantho.git",
    "directory": "packages/studio"
  },
  "bugs": {
    "url": "https://github.com/descoped/krantho/issues"
  },
  "type": "module",
  "exports": {
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "test": "vitest",
    "test:run": "vitest run",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@krantho/ai": "workspace:*",
    "@krantho/core": "workspace:*",
    "@krantho/seo-shared": "workspace:*",
    "@milkdown/core": "7.23.0",
    "@milkdown/plugin-history": "7.23.0",
    "@milkdown/preset-commonmark": "7.23.0",
    "@milkdown/preset-gfm": "7.23.0",
    "@milkdown/prose": "7.23.0",
    "@milkdown/utils": "7.23.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/dagre": "^0.7.54",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@xyflow/react": "^12.12.1",
    "dagre": "^0.8.5",
    "diff": "^9.0.0",
    "dompurify": "^3.4.17",
    "jsdom": "^31.0.0",
    "lucide-react": "^1.72.0",
    "marked": "^18.2.0",
    "react": "^19.3.1",
    "react-diff-viewer-continued": "^4.4.0",
    "react-dom": "^19.3.1",
    "react-image-crop": "^11.1.2",
    "react-router": "^8.5.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
