{
  "name": "@krantho/schema",
  "version": "1.1.1",
  "description": "Typed krantho content collections defined with Zod schemas, with validation, type inference and runtime schema merging.",
  "license": "MIT",
  "homepage": "https://krantho.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/descoped/krantho.git",
    "directory": "packages/schema"
  },
  "bugs": {
    "url": "https://github.com/descoped/krantho/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@krantho/core": "workspace:*",
    "@krantho/persistence": "workspace:*",
    "@krantho/seo-shared": "workspace:*",
    "gray-matter": "^4.0.3"
  },
  "peerDependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  }
}
