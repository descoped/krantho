{
  "name": "@krantho/ui-svelte",
  "version": "1.0.1",
  "description": "Svelte 5 components that render krantho content.",
  "license": "MIT",
  "homepage": "https://krantho.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/descoped/krantho.git",
    "directory": "packages/ui-svelte"
  },
  "bugs": {
    "url": "https://github.com/descoped/krantho/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "svelte": "./src/index.ts",
  "scripts": {
    "build": "echo 'Svelte package uses svelte-package (not yet configured)'",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@krantho/core": "workspace:*",
    "@krantho/seo-shared": "workspace:*"
  },
  "peerDependencies": {
    "svelte": ">=5.0.0"
  },
  "devDependencies": {
    "svelte-check": "^4.7.8"
  }
