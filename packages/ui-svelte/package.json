  },
  "dependencies": {
    "@krantho/core": "workspace:*",
    "@krantho/seo-shared": "workspace:*"
  },
  "peerDependencies": {
    "svelte": ">=5.0.0"
  },
  "devDependencies": {
    "svelte-check": "^4.7.6"
  }
}
