{
  "name": "@krantho/ui-svelte",
  "version": "1.0.0",
  "type": "module",
  "svelte": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "echo 'Svelte package uses svelte-package (not yet configured)'",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
