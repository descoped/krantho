{
  "name": "@krantho/server-sveltekit",
  "version": "1.0.1",
  "description": "The krantho adapter for SvelteKit: API and Studio endpoints, the content loader and CDN page caching.",
  "license": "MIT",
  "homepage": "https://krantho.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/descoped/krantho.git",
    "directory": "packages/server-sveltekit"
  },
  "bugs": {
    "url": "https://github.com/descoped/krantho/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@krantho/server": "workspace:*"
  },
  "peerDependencies": {
    "@sveltejs/kit": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "@sveltejs/kit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@krantho/schema": "workspace:*",
    "@types/node": "^26.6.6",
    "typescript": "^6.0.3",
    "zod": "^4.6.7"
  }
}
