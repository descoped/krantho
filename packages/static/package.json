{
  "name": "@krantho/static",
  "version": "1.0.2",
  "description": "Build a krantho site to static files: markdown content, structured SEO and the sitemap, for GitHub Pages or any file host.",
  "license": "MIT",
  "homepage": "https://krantho.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/descoped/krantho.git",
    "directory": "packages/static"
  },
  "bugs": {
    "url": "https://github.com/descoped/krantho/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./base-path": {
      "types": "./dist/base-path.d.ts",
      "import": "./dist/base-path.js",
      "default": "./dist/base-path.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@krantho/api": "workspace:*",
    "@krantho/config": "workspace:*",
    "@krantho/core": "workspace:*",
    "@krantho/schema": "workspace:*",
    "@krantho/server": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  }
}
