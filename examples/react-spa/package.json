{
  "name": "@krantho/example-react-spa",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/generate-content.ts && tsx scripts/generate-seo.ts && node --env-file-if-exists=../../.env node_modules/vite/bin/vite.js --port 4006",
    "build": "tsx scripts/generate-content.ts && tsx scripts/generate-seo.ts && vite build && tsx scripts/prerender.ts",
    "preview": "vite preview --port 4006",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@krantho/config": "workspace:*",
    "@krantho/core": "workspace:*",
    "@krantho/media-local": "workspace:*",
    "@krantho/schema": "workspace:*",
    "@krantho/server-node": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "gray-matter": "^4.0.3",
    "marked": "^18.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
