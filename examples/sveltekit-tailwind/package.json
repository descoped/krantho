{
  "name": "@krantho/example-sveltekit",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env node_modules/vite/bin/vite.js dev",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node build",
    "verify:cache": "node scripts/verify-cache.mjs",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@krantho/config": "workspace:*",
    "@krantho/core": "workspace:*",
    "@krantho/media-local": "workspace:*",
    "@krantho/persistence-fs": "workspace:*",
    "@krantho/persistence-sqlite": "workspace:*",
    "@krantho/schema": "workspace:*",
    "@krantho/server-sveltekit": "workspace:*",
    "@krantho/ui-svelte": "workspace:*",
    "@sveltejs/adapter-node": "^6.0.2",
    "@sveltejs/kit": "^3.2.0",
    "@tailwindcss/vite": "^4.3.5",
    "svelte": "^5.57.3",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@sveltejs/adapter-vercel": "^7.0.3",
    "@types/node": "^26.6.6",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  },
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*"
  }
}
