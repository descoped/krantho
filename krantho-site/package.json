{
  "name": "krantho-site",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../scripts/with-env.mjs ../.env node_modules/next/dist/bin/next dev",
    "build": "node scripts/content-dates.mjs && pnpm -w run seo validate --config --root krantho-site && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@krantho/api": "workspace:*",
    "@krantho/config": "workspace:*",
    "@krantho/core": "workspace:*",
    "@krantho/media-vercel-blob": "workspace:*",
    "@krantho/persistence": "workspace:*",
    "@krantho/persistence-fs": "workspace:*",
    "@krantho/persistence-postgres": "workspace:*",
    "@krantho/schema": "workspace:*",
    "@krantho/seo": "workspace:*",
    "@krantho/server": "workspace:*",
    "@krantho/server-next": "workspace:*",
    "@krantho/studio": "workspace:*",
    "@krantho/ui-react": "workspace:*",
    "@plausible-analytics/tracker": "^0.4.7",
    "marked": "^18.2.0",
    "minisearch": "^7.2.0",
    "next": "~16.4.6",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "typescript": "^6.0.3"
  },
  "note": "The krantho website, built with krantho on the workspace's own packages."
}
