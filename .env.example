# krantho — local development environment
#
# Copy to `.env` in the repository root. The example apps and krantho-site load this file
# when you run their `dev` script (node --env-file-if-exists). Every variable is optional.
# The full list of settings and their variables is docs/configuration.md.
# Never commit `.env`; it is gitignored.

# --- App stack: AI (enrichment and the assistant) ---
# Each provider has a credential of its own, and no provider reads another's. Choose the
# provider with KRANTHO_LLM_PROVIDER, set together with its key: a key alone picks none.
# Defaults: anthropic, claude-haiku-4-5. This is the provider a deployment sets, with a
# Console API key billed per token.
KRANTHO_LLM_PROVIDER=anthropic
KRANTHO_LLM_ANTHROPIC_API_KEY=
# KRANTHO_LLM_OPENAI_API_KEY=
# KRANTHO_LLM_GEMINI_API_KEY=
# KRANTHO_LLM_OPENROUTER_API_KEY=
# Development on your own machine only, never in a deployment: the claude-code provider runs
# on a Claude subscription token from `claude setup-token`, pinned to Haiku, and bills the
# subscription. Choose it with KRANTHO_LLM_PROVIDER=claude-code.
# KRANTHO_LLM_CLAUDE_CODE_OAUTH_TOKEN=
# Optional: a model, and a provider of its own for the assistant.
# KRANTHO_LLM_MODEL=claude-sonnet-5-5
# KRANTHO_ASSISTANT_PROVIDER=openai

# --- App stack: auth (off by default) ---
# KRANTHO_AUTH=token
# KRANTHO_API_TOKEN=change-me-to-a-long-random-secret
# Keeps login sessions valid across restarts; a temporary secret is used when unset.
# KRANTHO_JWT_SECRET=
